            Spacer(Modifier.height(16.dp))

            Text(
                text = if (isListening) "Processing voice input..." else "Press to activate",
                fontSize = 12.sp,
                fontFamily = FontFamily.Monospace,
                color = Color(0xFF00E0FF).copy(alpha = 0.6f)
