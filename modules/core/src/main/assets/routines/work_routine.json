{
  "version": "1.0",
  "timezone": "Asia/Kolkata",
  "networkSync": true,

  "routines": [
    {
      "id": "weekday_morning_lectures",
      "name": "Morning Lectures Block",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "08:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "network_time_sync" },
        { "type": "set_mode", "mode": "WORK" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Morning lectures started. Focus on current classes."
        },
        {
          "type": "notify",
          "message": "08:00–14:00: Current lectures block."
        }
      ]
    },

    {
      "id": "weekday_lunch_reset",
      "name": "Lunch and Reset",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "14:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "NORMAL" },
        { "type": "set_dnd", "dnd": false },
        {
          "type": "notify",
          "message": "14:00–15:00: Lunch and mental reset."
        }
      ]
    },

    {
      "id": "weekday_reactivation_block",
      "name": "Reactivation Block",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "15:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "FOCUS" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Reactivation block started. Resume syllabus sweep."
        },
        {
          "type": "notify",
          "message": "15:00–18:00: Reactivation and revision."
        }
      ]
    },

    {
      "id": "weekday_oxygen_hour",
      "name": "Oxygen Hour",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "18:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "NORMAL" },
        {
          "type": "notify",
          "message": "18:00–19:00: Physical reset. Movement and breathing."
        }
      ]
    },

    {
      "id": "weekday_backlog_block",
      "name": "Backlog Lectures",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "19:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "WORK" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Backlog lectures block started."
        },
        {
          "type": "notify",
          "message": "19:00–21:00: Backlog clearance."
        }
      ]
    },

    {
      "id": "weekday_current_hw",
      "name": "Current Homework Block",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "21:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "FOCUS" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Start current homework. Two and a half hours. No backlog, no revision."
        },
        {
          "type": "notify",
          "message": "21:00–23:30: Current homework (2.5 hours)."
        }
      ]
    },

    {
      "id": "weekday_skipped_hw",
      "name": "Skipped Homework Clearance",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "23:30",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "FOCUS" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Clear skipped homework. Fifty minutes only."
        },
        {
          "type": "notify",
          "message": "23:30–00:20: Skipped homework (50 minutes)."
        }
      ]
    },

    {
      "id": "weekday_backlog_hw",
      "name": "Backlog Homework Sprint",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "00:20",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "FOCUS" },
        { "type": "set_dnd", "dnd": true },
        {
          "type": "speak",
          "message": "Backlog homework sprint. Thirty minutes."
        },
        {
          "type": "notify",
          "message": "00:20–00:50: Backlog homework (30 minutes)."
        }
      ]
    },

    {
      "id": "weekday_night_buffer",
      "name": "Night Wrap and Save Progress",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "00:50",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "NORMAL" },
        { "type": "set_dnd", "dnd": false },
        {
          "type": "notify",
          "message": "00:50–01:00: Save work, note carryovers, prep tomorrow."
        }
      ]
    },

    {
      "id": "weekday_wind_down",
      "name": "Late Night Wind Down",
      "enabled": true,
      "trigger": {
        "type": "time",
        "time": "01:00",
        "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"]
      },
      "actions": [
        { "type": "set_mode", "mode": "NORMAL" },
        { "type": "set_dnd", "dnd": false },
        {
          "type": "notify",
          "message": "01:00–03:00: Light work or planning only. Wind down."
        }
      ]
    }
  ]
}
